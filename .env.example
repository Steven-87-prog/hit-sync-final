PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
# Leave blank for local dev (defaults to ./data). In production without a
# persistent disk, leave this blank too — Upstash Redis (below) is used
# instead. See DEPLOY.md for details.
DATA_DIR=
# Optional even in production, but required if you want data to survive
# restarts on a host without a persistent disk (e.g. Render's free tier).
# Free forever at https://upstash.com — create a Redis database, copy these
# two values from its REST API section. Leave blank for local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional — enables real SMS texts to a player's phone number when they get
# a hit request, acceptance, decline, or cancellation. Requires a Twilio
# account (paid, ~$1/month for a number + a few cents per text). Leave all
# three blank to skip SMS entirely — the app works fully without it, using
# in-app notifications only. See DEPLOY.md for setup steps.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Your site's real public URL — used to build the "Open Hit Sync: ..." link
# included in every SMS text (only matters if Twilio is configured above).
# Set this to your Render URL (or custom domain once you have one), e.g.
# https://hit-sync.onrender.com — no trailing slash needed either way.
APP_URL=http://localhost:4000
